#!ipxe
# dhcp

set BASEURL             {{ os_repo_url }}

############################ MAIN MENU ################################
:start
menu iPXE Boot Menu for {{ name }} ({{ ip_address }})
item
item --gap --       --------------------------- Operating Systems ----------------------------
item --key 0 boot   [0] {{ os }} {{ os_version }}
item --gap --       --------------------------- Advanced Options -----------------------------
item --key l show   [l] Show configuration for this machine
item --key k kick   [k] Show kickstart file for this machine
item --key c config [c] Configure Settings
item --key s shell  [s] Enter iPXE-Shell
item --key r reboot [r] System Reboot
item --gap --       --------------------------------------------------------------------------
item --gap --       ------------ Generated by bootique at {{ time_generated }} UTC ------------
item --gap --       --------------------------------------------------------------------------
choose --default boot --timeout 10000 target && goto ${target}

############################## Main ITEMS ##############################

:boot
set sp:hex 20
set sp ${sp:string}

echo Booting kernel:
echo ${BASEURL}/os/images/pxeboot/vmlinuz
echo with initrd:
echo ${BASEURL}/os/images/pxeboot/initrd.img
echo
echo Depending on the content of the kickstart file,
echo THIS MAY WIPE YOUR ENTIRE DISK INCLUDING THE OPERATING SYSTEM!
echo Do you with to continue?
echo
echo -n Type (YES) to continue:${sp} && read confirm
iseq ${confirm} YES && goto startboot || goto start


:startboot
kernel ${BASEURL}/os/images/pxeboot/vmlinuz inst.ks={{ origin }}/kickstart inst.repo=${BASEURL}/os
initrd ${BASEURL}/os/images/pxeboot/initrd.img
boot

:shell
echo Type 'exit' to go back to menu
shell
goto start

:show
{{ echo_configuration }}
goto start

:kick
{{ echo_kickstart }}
goto start

:failed
echo Booting failed, dropping to menu
goto start

:reboot
reboot

:config
config
goto start
